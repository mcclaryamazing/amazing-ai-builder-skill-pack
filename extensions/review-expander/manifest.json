{
  "manifest_version": 3,
  "name": "Product Review Intelligence",
  "description": "Expand and view all visible reviews.",
  "version": "1.8.5",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.de/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Product Review Intelligence",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.de/*"
      ],
      "js": [
        "product-data.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.de/*"
      ],
      "js": [
        "dedupe.js",
        "collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
